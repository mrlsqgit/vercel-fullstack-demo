# Vercel Postgres Environment Variables
# Copy this file to .env.local and fill in your values

# Database connection (from Vercel Postgres dashboard)
POSTGRES_URL=postgresql://user:password@host:5432/database?sslmode=require
POSTGRES_PRISMA_URL=postgresql://user:password@host:5432/database?pgbouncer=true&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/database?sslmode=require
POSTGRES_USER=user
POSTGRES_HOST=host
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=database
